<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Fires on status change of a service desk registration</description>
    <environments>Default</environments>
    <interviewLabel>RT - Service Desk Registration - Status Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT - Service Desk Registration - Status Change</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Publish_Event</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Service_Desk_Registration__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Publishes event to notify subscribers of queue updates</description>
        <name>Publish_Event</name>
        <label>Publish Event</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <flowName>AL_Create_Service_Desk_Registration_Queue_Update</flowName>
        <inputAssignments>
            <name>VART_Service_Desk_Registration_Location</name>
            <value>
                <elementReference>$Record.Service_Desk_Physical_Location__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
