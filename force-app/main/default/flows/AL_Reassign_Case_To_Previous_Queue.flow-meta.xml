<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <decisions>
        <description>Determine if the Case&#39;s previous Owner was a Queue. Since the collection is sorted to feed the newest record first, the last Queue that the Case was assigned to will automatically end the loop and the flow.</description>
        <name>Is_Previous_Case_Owner_A_Queue</name>
        <label>Is Previous Case Owner A Queue?</label>
        <locationX>1194</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Get_Previous_Queue_Assignments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Old Value is User</defaultConnectorLabel>
        <rules>
            <name>Old_Value_Is_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Previous_Queue_Assignments.OldValue</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Owner_To_Previous_Queue</targetReference>
            </connector>
            <label>Old Value Is Queue</label>
        </rules>
    </decisions>
    <decisions>
        <description>If there was no Queue as a previous record owner, the Case can be assigned to a Queue based on the Case Label. If the Label is Woonstad, the Woonstad Queue is used. If the Label is Stadswonen, the Stadswonen Queue is used. If Label is null or unknown, the Woonstad Queue is also used.</description>
        <name>What_Is_The_Case_Label</name>
        <label>What Is The Case Label</label>
        <locationX>842</locationX>
        <locationY>842</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Get_Woonstad_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Null Or Unknown</defaultConnectorLabel>
        <rules>
            <name>Woonstad</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varR_Case.Label__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Woonstad</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Woonstad_Queue</targetReference>
            </connector>
            <label>Woonstad</label>
        </rules>
        <rules>
            <name>Stadswonen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varR_Case.Label__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Stadswonen</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Stadswonen_Queue</targetReference>
            </connector>
            <label>Stadswonen</label>
        </rules>
    </decisions>
    <description>Reassign the Case to its previous Queue if its status has changed to a &quot;Paused&quot; value.</description>
    <environments>Default</environments>
    <interviewLabel>AL - Reassign Case To Previous Queue {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AL - Reassign Case To Previous Queue</label>
    <loops>
        <description>Loop through the Case&#39;s previous values to find the first re-assignment from a Queue.</description>
        <name>Get_Previous_Queue_Assignments</name>
        <label>Get Previous Queue Assignments</label>
        <locationX>842</locationX>
        <locationY>242</locationY>
        <collectionReference>Get_Case_History_Values</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
