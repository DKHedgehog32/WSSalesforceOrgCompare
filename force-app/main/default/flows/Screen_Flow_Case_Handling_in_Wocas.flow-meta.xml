                <fields>
                    <name>Txt_QueueMessage</name>
                    <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;This Case is currently assigned to a queue and not yet to a specific customer contact employee. In order to follow up the Case further in Wocas, the system needs a case owner. As soon as you click on &#39;Next&#39;, a contact moment will be entered in Wocas and you will be marked as &#39;handler&#39;. The Case ownership of the queue will also be transferred to you.&lt;/p&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>10</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <fields>
                <name>Screen_Queue_Message_Section1_Column3</name>
