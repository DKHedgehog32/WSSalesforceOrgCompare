    <decisions>
        <description>Determine if button is triggered on the Business Account or Person Account record in order to assign AccountId or PersonContactIdto variable</description>
        <name>Is_Account_Record_A_Business_Account_Or_Person_Account</name>
        <label>Is Account Record A Business Account Or Person Account</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Screen_Select_Relation_Type_BA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Business Account</defaultConnectorLabel>
        <rules>
            <name>PersonAccount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Running_User_Has_Custom_Permission_To_Add_Manage_Special_Relations</targetReference>
            </connector>
            <label>PersonAccount</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determine if the running user has the permission to enter special relations data for this Account record</description>
        <name>Running_User_Has_Custom_Permission_To_Add_Manage_Special_Relations</name>
        <label>Running User Has Custom Permission To Add &amp; Manage Special Relations</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>PA_Screen_Select_ACR_Relation_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_User_Has_Custom_Permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Manage_Special_Relationships</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Select_Relation_Type</targetReference>
            </connector>
            <label>Yes, User Has Custom Permission</label>
        </rules>
    </decisions>
    <decisions>
