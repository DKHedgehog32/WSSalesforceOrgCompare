        </defaultConnector>
        <defaultConnectorLabel>Special Relationship</defaultConnectorLabel>
        <rules>
            <name>AccountContactRelationship</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varT_RelationType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CPE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varT_RelationType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDW</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_AccountContactRelationship</targetReference>
            </connector>
            <label>AccountContactRelationship</label>
        </rules>
    </decisions>
