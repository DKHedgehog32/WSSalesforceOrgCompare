        <dataType>String</dataType>
        <expression>LEFT({!Loop_Through_Contract_Roles_For_Contract_Party.Real_Estate_Contract__r.Contract_Party__r.Name}, FIND(&quot; &quot;, {!Loop_Through_Contract_Roles_For_Contract_Party.Real_Estate_Contract__r.Contract_Party__r.Name}) - 1)</expression>
    </formulas>
