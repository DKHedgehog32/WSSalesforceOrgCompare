    <decisions>
        <description>If the Account has been identified as an Owner, that Account Type value should be prioritized. After that, in order, are Tenant, Co-Tenant, Former Tenant and Payer should be used as Account Type. If none of the booleon variables are true, the Account Type should be set to Account without contract.</description>
        <name>What_Type_Of_Account</name>
        <label>What Type Of Account</label>
        <locationX>1370</locationX>
        <locationY>734</locationY>
        <defaultConnector>
            <targetReference>Update_Account_Type_To_Account_Without_Contract</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Is_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varB_Owner</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Type_To_Owner</targetReference>
            </connector>
            <label>Is Owner</label>
        </rules>
        <rules>
            <name>Is_Tenant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varB_Tenant</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Type_To_Tenant</targetReference>
            </connector>
            <label>Is Tenant</label>
        </rules>
        <rules>
            <name>Is_Co_Tenant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varB_CoTenant</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Type_To_Co_Tenant</targetReference>
            </connector>
            <label>Is Co-Tenant</label>
        </rules>
        <rules>
            <name>Is_Former_Tenant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varB_FormerTenant</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Type_To_Former_Tenant</targetReference>
            </connector>
            <label>Is Former Tenant</label>
        </rules>
        <rules>
            <name>Is_Payer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varB_Payer</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Type_To_Payer</targetReference>
            </connector>
            <label>Is Payer</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determine what is the type of Contract Contact Role that is found in the collection variable.</description>
        <name>What_Type_Of_Contract_Contact_Role_Is_Found</name>
