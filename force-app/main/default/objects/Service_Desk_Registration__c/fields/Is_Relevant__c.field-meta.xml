<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Relevant__c</fullName>
    <description>Used by the logic to determine if the record is currently relevant when displaying the queue/at desk</description>
    <externalId>false</externalId>
    <formula>AND(
NOT( ISPICKVAL(Status__c,&#39;Completed&#39;)),
DATEVALUE(CreatedDate) =  TODAY() 
)</formula>
    <label>Is Relevant</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
